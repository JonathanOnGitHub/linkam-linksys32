# Vendor media and reverse-engineering artefacts.
# These contain the copyrighted Linksys32 installation CD, extracted
# proprietary binaries (PimMegaApi, Pixelink SDK, ActiveX controls), and
# bulk string dumps. They are deliberately not published.
backup/

# Aravis, unpacked from the Debian packages into a local prefix when
# it is not installed system-wide.  A vendor artefact, not source.
aravis-root/

# Recorded runs: the telemetry CSVs and the programme results.  These
# are data, not source.
results/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

